{
  "type": "function",
  "function": {
    "name": "probe_ui_accessibility",
    "description": "Grade whether a live page or Electron window exposes a usable accessibility tree before automating it. Connects to a Chrome DevTools Protocol endpoint (or accepts a pre-collected tree), reports interactive node counts, naming and coordinate coverage, and recommends 'a11y_primary', 'hybrid' or 'vision_only'.",
    "parameters": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "cdp",
            "inline"
          ],
          "default": "cdp"
        },
        "cdp_url": {
          "type": "string",
          "description": "DevTools endpoint, for example http://127.0.0.1:9222."
        },
        "target": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "target_url": {
          "type": "string",
          "description": "Pin the page by URL substring; more stable than target in multi-tab desktops."
        },
        "url": {
          "type": "string",
          "description": "Optional page to navigate before the tree is read."
        },
        "timeout_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 120,
          "default": 20
        },
        "elements": {
          "type": "array",
          "description": "Inline accessibility nodes, used when mode='inline'.",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "rect": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              }
            },
            "required": [
              "role"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "strict": false
  }
}