# Copy to .env and replace the API key before exposing the service.
LABEL_CONTROLLERS_API_PORT=8000
LABEL_CONTROLLERS_API_KEY=change-me-to-a-long-random-value
LABEL_CONTROLLERS_LOG_LEVEL=info
LABEL_CONTROLLERS_MAX_UPLOAD_MB=20
LABEL_CONTROLLERS_MAX_IMAGE_PIXELS=40000000
LABEL_CONTROLLERS_IMGSZ=1280
LABEL_CONTROLLERS_ICON_CONFIDENCE=0.18
LABEL_CONTROLLERS_OCR_CONFIDENCE=0.40
LABEL_CONTROLLERS_CORS_ORIGINS=