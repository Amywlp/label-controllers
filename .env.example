# Copy to .env and replace the API key before exposing the service.
LABEL_CONTROLLERS_API_PORT=8000
LABEL_CONTROLLERS_API_KEY=change-me-to-a-long-random-value
LABEL_CONTROLLERS_LOG_LEVEL=info
LABEL_CONTROLLERS_MAX_UPLOAD_MB=20
LABEL_CONTROLLERS_MAX_IMAGE_PIXELS=40000000
LABEL_CONTROLLERS_IMGSZ=1280
LABEL_CONTROLLERS_ICON_CONFIDENCE=0.18
LABEL_CONTROLLERS_OCR_CONFIDENCE=0.40
LABEL_CONTROLLERS_DEVICE=auto
LABEL_CONTROLLERS_DEVICE_INDEX=0
LABEL_CONTROLLERS_OCR_DEVICE=auto
# 0 auto-selects 12 on GPU and 6 on CPU; override only for benchmark tuning.
LABEL_CONTROLLERS_OCR_REC_BATCH_NUM=0
LABEL_CONTROLLERS_CORS_ORIGINS=

# Native Windows Desktop Adapter (not available inside Docker).
# Keep the adapter bound to loopback unless it is protected by TLS and a strong token.
LABEL_CONTROLLERS_DESKTOP_HOST=127.0.0.1
LABEL_CONTROLLERS_DESKTOP_PORT=8022
LABEL_CONTROLLERS_DESKTOP_TOKEN=change-me-to-a-separate-long-random-value
LABEL_CONTROLLERS_DESKTOP_ALLOW_INPUT=false
LABEL_CONTROLLERS_DESKTOP_ALLOW_ACTIVATE=false
LABEL_CONTROLLERS_DESKTOP_INFERENCE_URL=http://127.0.0.1:8011
LABEL_CONTROLLERS_DESKTOP_INFERENCE_API_KEY=
LABEL_CONTROLLERS_DESKTOP_CAPTURE_MODE=auto
LABEL_CONTROLLERS_DESKTOP_SESSION_TTL_SECONDS=300
LABEL_CONTROLLERS_DESKTOP_MAX_ACTIONS=32
LABEL_CONTROLLERS_DESKTOP_SAFE_MARGIN_PX=2
